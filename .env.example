# Copy to .env and fill in locally. Never commit .env.
# Network: regtest or signet only. Mainnet is not supported.
# JAAY_NETWORK=regtest
# Backend adapter: nwc, lnbits or sandbox.
# JAAY_BACKEND=sandbox
# Receive-only NWC connection string (never commit a real one).
# JAAY_NWC_URL=
# LNbits base URL and invoice (receive-only) key.
# JAAY_LNBITS_URL=
# JAAY_LNBITS_INVOICE_KEY=
# Key used to encrypt secrets at rest on the server.
# JAAY_SECRET_KEY=
