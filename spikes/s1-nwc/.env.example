# Written by scripts/stack.sh. Never commit the real .env.
# Receive-only NWC connection created in the local Alby Hub (scopes: get_info, make_invoice, lookup_invoice).
NWC_URL=nostr+walletconnect://<wallet-pubkey-hex>?relay=ws%3A%2F%2F127.0.0.1%3A10547&secret=<app-secret-hex>
# Payer node (lnd2) REST API, used only by the probe to pay invoices.
LND2_REST=127.0.0.1:8082
LND2_MACAROON_HEX=<admin-macaroon-hex>
LND2_TLS_CERT=.secrets/lnd2-tls.cert
