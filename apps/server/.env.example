# production requires JAAY_MASTER_KEY and BASE_URL
NODE_ENV=development
# default 8787
PORT=8787
# public https origin; http only for localhost; must be the same host wallets call
BASE_URL=http://localhost:8787
# default :memory: in dev, /data/jaay.sqlite in production
DB_PATH=:memory:
# 32 random bytes, base64; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# encrypts device secrets and wallet connection strings at rest; losing it makes enrolled devices unusable
JAAY_MASTER_KEY=
# 1 enables the labeled fake backend and /sandbox routes (off by default; compose.yaml turns it on for the demo)
SANDBOX=
# 1 lets a sandbox server also enroll real regtest or signet backends
JAAY_ALLOW_MIXED=
# 1 reads client IP from the first X-Forwarded-For entry; only behind your own reverse proxy
TRUST_PROXY=
# Anti-SSRF allowlists (enrollment is open, so the server only contacts hosts the operator lists here).
# LNbits host[:port] values, comma separated; empty means LNbits enrollment is refused.
LNBITS_ALLOWED_HOSTS=
# Exact NWC relay URLs, comma separated; default is Alby's public relays. Local regtest: ws://127.0.0.1:10547
NWC_ALLOWED_RELAYS=wss://relay.getalby.com/v1,wss://relay2.getalby.com/v1
